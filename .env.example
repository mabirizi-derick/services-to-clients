# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: Your MongoDB Atlas connection string (add in AI Studio Secrets or Vercel Environment Variables)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=""

# MONGODB_DB_NAME: Optional database name inside MongoDB (defaults to banda_services)
MONGODB_DB_NAME="banda_services"

# JWT_SECRET: Secret key for signing JWT authentication tokens
JWT_SECRET="replace_with_a_long_random_secret"
